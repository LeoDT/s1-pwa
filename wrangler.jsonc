{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s1-pwa",
  "main": "server/cf/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
