{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s1-pwa",
  "main": "server/cf/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "s1-progress",
      "database_id": "a3d2c225-858f-4eb3-94d8-845bed81a472",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
